        "status": "advisory",
        "reason": "supported",
        "summary": "Observation reviewed. No action was executed.",
        "findings": [
          {
            "id": "reported_alarms",
            "text": "The snapshot reports alarm records. Their presence alone does not establish the initiating cause."
          },
          {
            "id": "reactor_warming",
            "text": "Reactor temperature increased by at least 2 DEG C from the first to the last sample in the simulation window."
          },
          {
            "id": "jacket_warming",
            "text": "Jacket temperature increased by at least 3 DEG C across the simulation window."
          },
          {
            "id": "coolant_output_high",
            "text": "The latest coolant-controller output indication is at least 95 percent. An output command is not proof of valve position or available cooling."
          },
          {
            "id": "cooling_path_unconfirmed",
            "text": "Rising reactor and jacket temperatures coincide with a high coolant output indication. Cooling impairment is a hypothesis; these measurements do not distinguish utility loss, valve response, instrumentation, or other causes."
          },
          {
            "id": "cause_unresolved",
            "text": "This bounded observation window cannot establish a unique root cause or rule out an unobserved fault."
          }
        ],
        "checks": [
